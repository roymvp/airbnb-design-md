{
  "name": "airbnb 风格",
  "version": "0.1.0",
  "source": "https://github.com/VoltAgent/awesome-design-md/blob/main/design-md/airbnb/DESIGN.md",
  "format": "css-custom-properties",
  "values": {
    "--background": "#ffffff",
    "--foreground": "#222222",
    "--card": "#ffffff",
    "--primary": "#ff385c",
    "--primary-active": "#e00b41",
    "--primary-disabled": "#ffd1da",
    "--muted": "#f7f7f7",
    "--muted-foreground": "#6a6a6a",
    "--border": "#dddddd",
    "--destructive": "#c13515",
    "--radius": "14px",
    "--elevation-float": "0 0 0 1px rgb(0 0 0 / 2%), 0 2px 6px rgb(0 0 0 / 4%),\n    0 4px 8px rgb(0 0 0 / 10%)"
  },
  "theme": {
    "--font-sans": "var(--font-inter, Inter), \"PingFang SC\", \"Microsoft YaHei\",\n    var(--font-cjk, \"Noto Sans SC\"), system-ui, sans-serif",
    "--color-background": "var(--background)",
    "--color-foreground": "var(--foreground)",
    "--color-card": "var(--card)",
    "--color-card-foreground": "var(--foreground)",
    "--color-popover": "var(--background)",
    "--color-popover-foreground": "var(--foreground)",
    "--color-primary": "var(--primary)",
    "--color-primary-foreground": "var(--background)",
    "--color-primary-active": "var(--primary-active)",
    "--color-primary-disabled": "var(--primary-disabled)",
    "--color-secondary": "var(--muted)",
    "--color-secondary-foreground": "var(--foreground)",
    "--color-muted": "var(--muted)",
    "--color-muted-foreground": "var(--muted-foreground)",
    "--color-accent": "var(--muted)",
    "--color-accent-foreground": "var(--foreground)",
    "--color-destructive": "var(--destructive)",
    "--color-border": "var(--border)",
    "--color-input": "var(--border)",
    "--color-ring": "var(--foreground)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "14px",
    "--radius-lg": "20px",
    "--radius-xl": "32px",
    "--radius-full": "9999px",
    "--shadow-float": "var(--elevation-float)",
    "--breakpoint-sm": "46.5rem",
    "--breakpoint-md": "46.5rem",
    "--breakpoint-lg": "70.5rem",
    "--breakpoint-xl": "90rem",
    "--text-display": "28px",
    "--text-display--line-height": "1.4",
    "--text-display--font-weight": "700",
    "--text-heading": "22px",
    "--text-heading--line-height": "1.3",
    "--text-heading--font-weight": "500",
    "--text-rating": "64px",
    "--text-rating--line-height": "1.1",
    "--text-rating--font-weight": "700",
    "--spacing-section": "64px",
    "--container-content": "1280px"
  }
}